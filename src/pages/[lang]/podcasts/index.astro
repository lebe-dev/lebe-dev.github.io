---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations, formatDate } from '../../../i18n/utils';
import { languages, type Lang } from '../../../i18n/ui';
import { formatTimecode, listEpisodes } from '../../../lib/podcasts';
import { getBlogPosts } from '../../../lib/blog';
import ReadingMarks from '../../../components/ReadingMarks.astro';

export async function getStaticPaths() {
  // The blog post about the translation method — same one for every locale,
  // tied together by translationKey.
  const methodPosts = await getBlogPosts((e) => e.data.translationKey === 'translate-podcasts-with-llm');
  const slug = (id: string) => id.replace(/^[a-z]{2}\//, '');

  return (Object.keys(languages) as Lang[]).map((lang) => {
    const post = methodPosts.find((e) => e.data.lang === lang);
    return {
      params: { lang },
      props: { methodUrl: post ? `/${lang}/blog/${slug(post.id)}/` : undefined },
    };
  });
}

const lang = Astro.params.lang as Lang;
const { methodUrl } = Astro.props;
const t = useTranslations(lang);
const episodes = listEpisodes(lang);

// One filter chip per show, in the order the shows first appear in the listing.
const shows = [...new Set(episodes.map((e) => e.podcast))];
---
<BaseLayout lang={lang} title={t('podcasts.title')} description={t('podcasts.description')} minimalHeader>
  <h1>{t('podcasts.title')}</h1>
  <p class="muted lede">
    {t('podcasts.lede')}
    {methodUrl && <> <a href={methodUrl}>{t('podcasts.methodLink')} →</a></>}
  </p>

  {episodes.length > 0 && (
    /* Inert without JS, so the script below is what reveals it. */
    <div class="search" data-search-wrap hidden>
      <label class="visually-hidden" for="podcast-search">{t('podcasts.searchLabel')}</label>
      <input
        type="search"
        id="podcast-search"
        data-search
        placeholder={t('podcasts.searchPlaceholder')}
        autocomplete="off"
      />
    </div>
  )}

  {shows.length > 0 && (
    /* Inert without JS, so the script below is what reveals it. */
    <div class="filters" role="group" aria-label={t('podcasts.filterByShow')} data-filters hidden>
      <button type="button" class="filter active" aria-pressed="true" data-show="">
        {t('podcasts.allShows')}
      </button>
      {shows.map((show) => (
        <button type="button" class="filter" aria-pressed="false" data-show={show}>{show}</button>
      ))}
    </div>
  )}

  {episodes.length > 0 && (
    /* Inert without JS, so the script below is what reveals it. */
    <div class="sort" role="group" aria-label={t('podcasts.sortByEpisode')} data-sort hidden>
      <button type="button" class="filter active" aria-pressed="true" data-sort-dir="desc">
        {t('podcasts.sortNewestFirst')}
      </button>
      <button type="button" class="filter" aria-pressed="false" data-sort-dir="asc">
        {t('podcasts.sortOldestFirst')}
      </button>
    </div>
  )}

  {episodes.length === 0 ? (
    <p class="muted">{t('podcasts.empty')}</p>
  ) : (
    <>
    <p class="muted" data-no-results hidden>{t('podcasts.noResults')}</p>
    <ul class="podcast-list" role="list">
      {episodes.map((e) => (
        <li
          data-podcast={e.podcast}
          data-title={e.title.toLowerCase()}
          data-guest={(e.guest ?? '').toLowerCase()}
          data-episode={e.episode ?? ''}
        >
          <article aria-labelledby={`ep-${e.slug}`}>
            <h2 class="ep-title" id={`ep-${e.slug}`}>
              <a href={`/${lang}/podcasts/${e.slug}/`} lang={e.titleLang}>{e.title}</a>
              {/* Filled in from localStorage by ReadingMarks.astro. The episode
                  is scrolled through separately in each transcript language. */}
              <span
                class="reading-mark"
                data-reading-mark
                data-read-id={`podcast:${e.slug}`}
                data-progress-ids={e.langs.map((l) => `podcast:${e.slug}:${l}`).join(',')}
                hidden
              ></span>
            </h2>
            <p class="ep-meta">
              <span>
                {e.podcast}{e.episode !== undefined && <span class="ep-number"> #{e.episode}</span>}
              </span>
              {e.guest && (
                <span>
                  <span class="visually-hidden">{t('podcasts.guest')}: </span>
                  <a href={`/${lang}/podcasts/?q=${encodeURIComponent(e.guest)}`}>{e.guest}</a>
                </span>
              )}
              {e.duration && (
                <span>
                  <span class="visually-hidden">{t('podcasts.duration')}: </span>
                  {formatTimecode(e.duration)}
                </span>
              )}
              <span class="ep-langs">
                <span class="visually-hidden">{t('podcasts.transcriptLang')}: </span>
                {e.langs.map((l) => languages[l as Lang]).join(' · ')}
              </span>
              <span class="ep-added">
                <span class="visually-hidden">{t('podcasts.added')}: </span>
                <time datetime={e.dateAdded}>{formatDate(new Date(e.dateAdded))}</time>
              </span>
            </p>
          </article>
        </li>
      ))}
    </ul>
    </>
  )}

  <ReadingMarks lang={lang} />
</BaseLayout>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  const sortBar = document.querySelector<HTMLElement>('[data-sort]');
  const searchWrap = document.querySelector<HTMLElement>('[data-search-wrap]');
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const noResults = document.querySelector<HTMLElement>('[data-no-results]');
  const list = document.querySelector<HTMLUListElement>('.podcast-list');
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('.podcast-list li'));

  // Sort direction persists across visits (unlike the show filter and
  // search, which are per-navigation via ?show=/?q=).
  const SORT_STORAGE_KEY = 'podcast-sort-dir';

  const loadStoredSortDir = (): 'asc' | 'desc' | null => {
    try {
      const stored = localStorage.getItem(SORT_STORAGE_KEY);
      return stored === 'asc' || stored === 'desc' ? stored : null;
    } catch {
      return null;
    }
  };

  const saveSortDir = (dir: 'asc' | 'desc') => {
    try {
      localStorage.setItem(SORT_STORAGE_KEY, dir);
    } catch {
      // Safari private mode etc. — sort still works for this visit.
    }
  };

  if (items.length > 0) {
    items[0].parentElement?.classList.add('filterable');

    let selectedShow = '';
    let sortDir: 'asc' | 'desc' = loadStoredSortDir() ?? 'desc';

    // :first-child/:last-child can't see past hidden items, so the spacing
    // of the first and last *visible* entry is marked explicitly.
    const markEdges = () => {
      const visible = items.filter((item) => !item.hidden);
      for (const item of items) {
        item.classList.toggle('is-first', item === visible[0]);
        item.classList.toggle('is-last', item === visible.at(-1));
      }
      if (noResults) noResults.hidden = visible.length > 0;
    };

    // Case-insensitive, matched against the title first and the guest
    // second — either field matching is enough to keep an entry visible.
    const matchesQuery = (item: HTMLLIElement, query: string) =>
      query === '' ||
      (item.dataset.title ?? '').includes(query) ||
      (item.dataset.guest ?? '').includes(query);

    const applyFilters = () => {
      const query = (search?.value ?? '').trim().toLowerCase();
      for (const item of items) {
        const showMatch = selectedShow === '' || item.dataset.podcast === selectedShow;
        item.hidden = !showMatch || !matchesQuery(item, query);
      }
      markEdges();
    };

    const episodeNumber = (item: HTMLLIElement): number | undefined => {
      const raw = item.dataset.episode;
      return raw ? Number(raw) : undefined;
    };

    // Episodes without a number sort last regardless of direction — there's
    // nothing to compare them by.
    const applySort = () => {
      items.sort((a, b) => {
        const av = episodeNumber(a);
        const bv = episodeNumber(b);
        if (av === undefined && bv === undefined) return 0;
        if (av === undefined) return 1;
        if (bv === undefined) return -1;
        return sortDir === 'desc' ? bv - av : av - bv;
      });
      if (list) {
        for (const item of items) list.appendChild(item);
      }
      markEdges();
    };

    // Lets a link (e.g. the episode page's back button) land here pre-filtered
    // to one show.
    const presetShow = new URLSearchParams(location.search).get('show');
    if (presetShow) selectedShow = presetShow;

    if (bar) {
      bar.hidden = false;
      if (presetShow) {
        for (const other of bar.querySelectorAll<HTMLButtonElement>('.filter')) {
          const active = other.dataset.show === presetShow;
          other.classList.toggle('active', active);
          other.setAttribute('aria-pressed', String(active));
        }
      }
      bar.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        const button = target.closest<HTMLButtonElement>('.filter');
        if (!button) return;

        selectedShow = button.dataset.show ?? '';
        for (const other of bar.querySelectorAll<HTMLButtonElement>('.filter')) {
          const active = other === button;
          other.classList.toggle('active', active);
          other.setAttribute('aria-pressed', String(active));
        }

        applyFilters();
      });
    }

    if (searchWrap && search) {
      searchWrap.hidden = false;
      search.addEventListener('input', applyFilters);

      // Lets a link (e.g. a guest's name on an episode page) land here pre-filtered.
      const presetQuery = new URLSearchParams(location.search).get('q');
      if (presetQuery) search.value = presetQuery;
    }

    if (sortBar) {
      sortBar.hidden = false;
      for (const other of sortBar.querySelectorAll<HTMLButtonElement>('.filter')) {
        const active = other.dataset.sortDir === sortDir;
        other.classList.toggle('active', active);
        other.setAttribute('aria-pressed', String(active));
      }
      sortBar.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        const button = target.closest<HTMLButtonElement>('.filter');
        if (!button) return;

        const dir = button.dataset.sortDir === 'asc' ? 'asc' : 'desc';
        saveSortDir(dir);
        if (dir === sortDir) return;
        sortDir = dir;
        for (const other of sortBar.querySelectorAll<HTMLButtonElement>('.filter')) {
          const active = other === button;
          other.classList.toggle('active', active);
          other.setAttribute('aria-pressed', String(active));
        }
        applySort();
      });
    }

    applySort();
    applyFilters();
  }
</script>

<style>
  /* Minimal header, no tagline: the default padding leaves too much air above the h1. */
  :global(main:has(.podcast-list)) {
    padding-top: 1rem;
  }

  .lede {
    margin: 0 0 1.25rem;
    font-size: 0.85rem;
  }

  .lede a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 2px;
    white-space: nowrap;
  }

  .lede a:hover {
    color: var(--link);
    text-decoration-color: currentColor;
  }

  .lede a:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .search {
    margin: 0 0 1rem;
  }

  .search[hidden] {
    display: none;
  }

  .search input {
    width: 100%;
    max-width: 28rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: none;
    color: var(--fg);
    font-family: var(--sans);
    font-size: 0.9rem;
  }

  .search input::placeholder {
    color: var(--text-muted);
  }

  .search input:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 2px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0 0 1rem;
  }

  .sort {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0 0 2.5rem;
  }

  .filters[hidden],
  .sort[hidden] {
    display: none;
  }

  .filter {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: none;
    color: var(--text-muted);
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .filter:hover {
    color: var(--fg);
    border-color: var(--fg);
  }

  .filter.active {
    background: var(--rule);
    color: var(--fg);
    border-color: var(--rule);
  }

  .filter:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 2px;
  }

  .podcast-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .podcast-list li {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .podcast-list li:first-child {
    padding-top: 0;
  }

  .podcast-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  /* Filtering out an entry must not leave its padding or rule behind. */
  .podcast-list li[hidden] {
    display: none;
  }

  /* Once the filters are live, :first-child/:last-child are meaningless —
     they can't see past hidden entries — so the script marks the edges itself. */
  .podcast-list.filterable li {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .podcast-list.filterable li.is-first {
    padding-top: 0;
  }

  .podcast-list.filterable li.is-last {
    border-bottom: none;
    padding-bottom: 0;
  }

  .ep-title {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.35;
    margin: 0;
    letter-spacing: -0.005em;
  }

  .ep-title a {
    text-decoration: none;
  }

  .ep-title a:hover {
    text-decoration: underline;
  }

  .ep-title a:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .ep-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.25rem;
    margin: 0.5rem 0 0;
    font-family: var(--sans);
    font-size: 0.85rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .ep-meta a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 2px;
  }

  .ep-meta a:hover {
    color: var(--link);
    text-decoration-color: currentColor;
  }

  .ep-meta a:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .ep-added {
    margin-left: auto;
  }

  @media (prefers-contrast: more) {
    .ep-meta {
      color: var(--fg);
    }
  }

  @media (max-width: 540px) {
    .ep-added {
      margin-left: 0;
    }
  }
</style>
