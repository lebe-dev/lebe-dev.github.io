---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Transcript from '../../../components/Transcript.svelte';
import { useTranslations, formatDate } from '../../../i18n/utils';
import { languages, type Lang } from '../../../i18n/ui';
import { podcasts } from '../../../data/podcasts';
import {
  availableLangs,
  formatTimecode,
  getTermHits,
  getTranscript,
  originalUrl,
  preferredLang,
  transcriptDuration,
} from '../../../lib/podcasts';

export const getStaticPaths = () =>
  (Object.keys(languages) as Lang[]).flatMap((lang) =>
    podcasts
      .filter((episode) => availableLangs(episode.slug).length > 0)
      .map((episode) => ({ params: { lang, slug: episode.slug } })),
  );

const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug!;
const t = useTranslations(lang);

const episode = podcasts.find((e) => e.slug === slug)!;
const langs = availableLangs(slug);
const initial = preferredLang(lang, langs)!;

const titles = Object.fromEntries(langs.map((l) => [l, getTranscript(slug, l)!.title]));
const transcripts = Object.fromEntries(
  langs.map((l) => [l, getTranscript(slug, l)!.transcript]),
);
const glossaries = Object.fromEntries(
  langs.flatMap((l) => {
    const glossary = getTranscript(slug, l)!.glossary;
    return glossary?.length ? [[l, glossary] as const] : [];
  }),
);
// Positions of those terms inside the transcript, precomputed by `just glossary`.
const termHits = Object.fromEntries(
  langs.flatMap((l) => {
    const hits = getTermHits(slug, l);
    return hits.length ? [[l, hits] as const] : [];
  }),
);
const langNames = Object.fromEntries(langs.map((l) => [l, languages[l]]));

const duration = transcriptDuration(getTranscript(slug, initial)!);
const guest = getTranscript(slug, initial)!.guest;
const sourceUrl = originalUrl(slug, langs, episode.sourceUrl);
const sourceHost = sourceUrl ? new URL(sourceUrl).hostname.replace(/^www\./, '') : undefined;
const onlyOneLang =
  langs.length === 1 ? t('podcasts.onlyOneLang').replace('{lang}', languages[langs[0]]) : undefined;
---
<BaseLayout
  lang={lang}
  title={titles[initial]}
  description={`${episode.podcast}${episode.episode !== undefined ? ` #${episode.episode}` : ''} — ${titles[initial]}`}
  minimalHeader
  backHref={`/${lang}/podcasts/?show=${encodeURIComponent(episode.podcast)}`}
>
  <div class="episode">
    <p class="show">
      {sourceUrl ? (
        <a href={sourceUrl} target="_blank" rel="noopener">{episode.podcast}</a>
      ) : episode.podcast}
      {episode.episode !== undefined && <span class="show-episode"> #{episode.episode}</span>}
    </p>

    <Transcript
      client:load
      titles={titles}
      transcripts={transcripts}
      glossaries={glossaries}
      termHits={termHits}
      langNames={langNames}
      initial={initial}
      switchLabel={t('podcasts.transcriptLang')}
      timecodeLabel={t('podcasts.copyTimecode')}
      glossaryLabel={t('podcasts.glossary')}
      guest={guest}
      guestHref={guest ? `/${lang}/podcasts/?q=${encodeURIComponent(guest)}` : undefined}
      guestLabel={t('podcasts.guest')}
    />

    {onlyOneLang && <p class="ep-note muted">{onlyOneLang}</p>}

    <footer class="ep-footer">
      <p class="ep-meta">
        {guest && <span>{t('podcasts.guest')}: {guest}</span>}
        {duration && (
          <span>
            <span class="visually-hidden">{t('podcasts.duration')}: </span>
            {formatTimecode(duration)}
          </span>
        )}
        <span>
          <span class="visually-hidden">{t('podcasts.added')}: </span>
          <time datetime={episode.dateAdded}>{formatDate(new Date(episode.dateAdded))}</time>
        </span>
        {episode.translatedWith && (
          <span>{t('podcasts.translatedWith')}: {episode.translatedWith}</span>
        )}
        {sourceUrl && (
          <span>
            {t('podcasts.listen')}:{' '}
            <a href={sourceUrl} target="_blank" rel="noopener">{sourceHost}</a>
          </span>
        )}
      </p>
      <p class="ep-back">
        <a href={`/${lang}/podcasts/`}>{t('podcasts.backToList')}</a>
      </p>
    </footer>
  </div>
</BaseLayout>

<style>
  :global(main:has(.episode)) {
    padding-top: 1rem;
  }

  .show {
    margin: 0 0 0.4rem;
    font-family: var(--sans);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .show a {
    color: inherit;
    text-decoration: none;
  }

  .show a:hover {
    color: var(--link);
  }

  .show-episode {
    font-variant-numeric: tabular-nums;
    font-weight: 400;
  }

  .episode :global(h1) {
    margin-top: 0;
  }

  .ep-note {
    margin: 2rem 0 0;
    font-family: var(--sans);
    font-size: 0.85rem;
  }

  .ep-footer {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .ep-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.25rem;
    margin: 0;
    font-family: var(--sans);
    font-size: 0.85rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .ep-back {
    margin: 1.25rem 0 0;
    font-family: var(--sans);
    font-size: 0.85rem;
  }

  .ep-back a {
    text-decoration: none;
  }

  .ep-back a:hover {
    text-decoration: underline;
  }

  @media (prefers-contrast: more) {
    .show,
    .ep-meta {
      color: var(--fg);
    }
  }
</style>
