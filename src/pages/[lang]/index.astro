---
import { getBlogPosts } from '../../lib/blog';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bio from '../../components/Bio.astro';
import ProjectsList from '../../components/ProjectsList.astro';
import PostsList from '../../components/PostsList.astro';
import HomeEntries from '../../components/HomeEntries.astro';
import ReadingMarks from '../../components/ReadingMarks.astro';
import { episodeDate, listEpisodes } from '../../lib/podcasts';
import { bookLabel, listBooks } from '../../lib/books';
import { subtitles } from '../../data/subtitles';
import type { HomeEntry } from '../../lib/homeEntries';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

export const getStaticPaths = () => [
  { params: { lang: 'en' } },
  { params: { lang: 'ru' } },
  { params: { lang: 'es' } },
  { params: { lang: 'zh' } },
  { params: { lang: 'ja' } },
  { params: { lang: 'fr' } },
  { params: { lang: 'de' } },
];

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const all = await getBlogPosts((e) => e.data.lang === lang);
const posts = all
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((e) => {
    const slug = e.id.replace(/^[a-z]{2}\//, '');
    return {
      slug,
      title: e.data.title,
      pubDate: e.data.pubDate,
      // Reading state is shared across translations.
      key: e.data.translationKey ?? slug,
    };
  });

// Each section below shows a preview of its listing, newest translation first.
const HOME_PREVIEW = 5;

// listEpisodes() already sorts by release date, newest first — the same order
// the listing page shows, so the preview and the dates in it agree.
const episodes = listEpisodes(lang).slice(0, HOME_PREVIEW);
const podcastEntries: HomeEntry[] = episodes.map((e) => ({
  href: `/${lang}/podcasts/${e.slug}/`,
  title: e.title,
  titleLang: e.titleLang,
  date: new Date(episodeDate(e).date),
  readId: `podcast:${e.slug}`,
  progressIds: e.langs.map((l) => `podcast:${e.slug}:${l}`),
}));

// The Russian-only sections; built for every locale but rendered only for ru.
// A book is named rather than dated — the date a book was added says little
// while its translation is still in progress.
const bookEntries: HomeEntry[] = listBooks()
  .slice(0, HOME_PREVIEW)
  .map((book) => ({
    href: `/books/${book.slug}/`,
    title: bookLabel(book),
  }));

// The subtitles page has no page per entry, so an entry links to its heading there.
const subtitleEntries: HomeEntry[] = [...subtitles]
  .sort((a, b) => new Date(b.dateAdded).valueOf() - new Date(a.dateAdded).valueOf())
  .slice(0, HOME_PREVIEW)
  .map((e) => ({
    href: `/subtitles/#sub-title-${e.fileName}`,
    title: e.title,
    date: new Date(e.dateAdded),
  }));
---
<BaseLayout lang={lang} resetVisited>
  <img class="home-banner home-banner--light" src="/images/blog-light-banner.png" alt="" aria-hidden="true" />
  <img class="home-banner home-banner--dark" src="/images/blog-dark-banner.png" alt="" aria-hidden="true" />
  <section aria-labelledby="posts-heading">
    <h2 id="posts-heading" class="section-title">
      {t('section.posts')}
      <a class="rss" href={`/${lang}/rss.xml`} aria-label={t('rss.title')} title={t('rss.title')}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.18 15.64a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36zM4 4.44A15.56 15.56 0 0 1 19.56 20h-2.84A12.72 12.72 0 0 0 4 7.28V4.44zm0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z" />
        </svg>
      </a>
    </h2>
    <PostsList lang={lang} posts={posts} />
  </section>
  <section aria-labelledby="podcasts-heading">
    <h2 id="podcasts-heading" class="section-title">{t('section.podcasts')}</h2>
    <p class="muted section-subtitle">{t('section.podcasts.subtitle')}</p>
    <HomeEntries entries={podcastEntries} />
    <p class="section-more">
      <a href={`/${lang}/podcasts/`}>{t('section.allPodcasts')}</a>
    </p>
  </section>
  {lang === 'ru' && (
    <section aria-labelledby="books-heading">
      <h2 id="books-heading" class="section-title">Переводы книг</h2>
      <p class="muted section-subtitle">Книги, которые я перевожу на русский</p>
      <HomeEntries entries={bookEntries} showDates={false} />
      <p class="section-more">
        <a href="/books/">Все переводы книг →</a>
      </p>
    </section>
  )}
  {lang === 'ru' && (
    <section aria-labelledby="subtitles-heading">
      <h2 id="subtitles-heading" class="section-title">Субтитры</h2>
      <p class="muted section-subtitle">Субтитры, которые я перевожу</p>
      <HomeEntries entries={subtitleEntries} />
      <p class="section-more">
        <a href="/subtitles/">Все субтитры →</a>
      </p>
    </section>
  )}
  <ReadingMarks lang={lang} />
  <ProjectsList lang={lang} />
  <Bio lang={lang} />
</BaseLayout>
