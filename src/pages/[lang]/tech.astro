---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

export const getStaticPaths = () => [
  { params: { lang: 'en' } },
  { params: { lang: 'ru' } },
  { params: { lang: 'es' } },
  { params: { lang: 'zh' } },
  { params: { lang: 'ja' } },
  { params: { lang: 'fr' } },
  { params: { lang: 'de' } },
];

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---
<BaseLayout lang={lang} title={t('tech.title')} description={t('tech.description')}>
  <article class="tech-page">
    <h1>{t('tech.title')}</h1>
    <p class="muted">{t('tech.intro')}</p>

    <h2>{t('tech.stack.title')}</h2>
    <p>{t('tech.stack.body')}</p>

    <h2>{t('tech.privacy.title')}</h2>
    <p>{t('tech.privacy.body')}</p>

    <h2>{t('tech.storage.title')}</h2>
    <p>{t('tech.storage.body')}</p>

    <h2>{t('tech.reading.title')}</h2>
    <p>{t('tech.reading.body')}</p>

    <h2>{t('tech.transfer.title')}</h2>
    <p>{t('tech.transfer.body')}</p>

    <h2>{t('tech.offline.title')}</h2>
    <p>{t('tech.offline.body')}</p>

    <h2>{t('tech.languages.title')}</h2>
    <p>{t('tech.languages.body')}</p>

    <h2>{t('tech.source.title')}</h2>
    <p>{t('tech.source.body')}</p>
    <p>
      <a href="https://github.com/lebe-dev/lebe-dev.github.io" rel="noopener" target="_blank">
        {t('tech.source.link')}
      </a>
    </p>
  </article>
</BaseLayout>

<style>
  .tech-page :global(h2) {
    margin-top: 2rem;
  }
</style>
