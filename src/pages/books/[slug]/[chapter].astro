---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ChapterBody from '../../../components/ChapterBody.svelte';
import ReadingProgress from '../../../components/ReadingProgress.svelte';
import { blocks } from '../../../lib/bookBlocks';
import { chapterHits, parseChapterId } from '../../../lib/bookChapters';
import {
  chapterKey,
  chapterLabel,
  chapterNeighbours,
  chapterTarget,
  findBook,
  findChapter,
  linkHost,
} from '../../../lib/books';
import { useTranslations } from '../../../i18n/utils';

/**
 * A chapter exists as a page only when its Markdown file does. Everything else
 * about it — its title, its number, where it sits in the book — comes from the
 * table of contents in src/data/books.ts, keyed by the file name.
 */
export const getStaticPaths = (async () => {
  const entries = await getCollection('books', ({ data }) => !data.draft);

  return entries.flatMap((entry) => {
    const { book: slug, key } = parseChapterId(entry.id);
    const book = findBook(slug);
    const chapter = book && findChapter(book, key);
    // A file whose name matches no entry in the contents would otherwise build
    // a page nothing links to and no reading state can name.
    if (!book || !chapter) {
      throw new Error(
        `src/content/books/${entry.id}.md matches no chapter in src/data/books.ts — ` +
          'the file name must be the chapter’s number or the slug of its original title.',
      );
    }
    return [{ params: { slug, chapter: key }, props: { book, chapter, entry } }];
  });
}) satisfies GetStaticPaths;

const { book, chapter, entry } = Astro.props;
const t = useTranslations('ru');

const key = chapterKey(chapter);
const body = blocks(entry.body ?? '');
const hits = chapterHits(entry.id);
const { prev, next } = chapterNeighbours(book, key);
const target = chapterTarget(book, chapter);

const heading =
  chapter.number !== undefined ? `${chapter.number}. ${chapter.title}` : chapter.title;

const hrefFor = (other: { number?: number; title: string; originalTitle: string }) =>
  `/books/${book.slug}/${chapterKey(other)}/`;

/** Only a chapter that has been translated can be linked to. */
const translated = new Set(
  (await getCollection('books', ({ data }) => !data.draft)).map((e) => e.id),
);
const linkable = (other: { number?: number; title: string; originalTitle: string }) =>
  translated.has(`${book.slug}/${chapterKey(other)}`);

const readingLabels = {
  progress: t('reading.progress'),
  markRead: t('reading.markRead'),
  markUnread: t('reading.markUnread'),
  read: t('reading.read'),
  resume: t('reading.resume'),
  resumeDismiss: t('reading.resumeDismiss'),
};
---
<BaseLayout
  lang="ru"
  title={`${chapter.title} — ${book.title}`}
  description={`«${chapter.originalTitle}» из книги «${book.originalTitle}» ${book.author} — перевод на русский.`}
  minimalHeader
  backHref={`/books/${book.slug}/`}
>
  <article class="chapter">
    <header class="chapter-head">
      <p class="chapter-book">
        <a href={`/books/${book.slug}/`}>{book.title}</a>
        {book.shortTitle && <span class="chapter-short"> · {book.shortTitle}</span>}
      </p>
      <h1>{heading}</h1>
      <p class="chapter-original" lang={book.originalLang}>{chapter.originalTitle}</p>
    </header>

    <ChapterBody
      client:load
      blocks={body}
      termHits={hits}
      glossary={entry.data.glossary}
      glossaryLabel={t('podcasts.glossary')}
    />

    <div class="chapter-tools">
      <ReadingProgress
        client:idle
        progressId={target.progressId}
        readId={target.readId}
        contentSelector=".chapter"
        labels={readingLabels}
      />
    </div>

    <footer class="chapter-foot">
      <p class="chapter-source">
        Оригинал главы:{' '}
        <a
          href={entry.data.sourceUrl}
          hreflang={book.originalLang}
          title={`Оригинал главы — ${linkHost(entry.data.sourceUrl)}, откроется в новой вкладке`}
          target="_blank"
          rel="noopener"
        >
          {chapter.originalTitle}
          <span class="visually-hidden"> — {linkHost(entry.data.sourceUrl)}, откроется в новой вкладке</span>
        </a>.
        {book.permission && (
          <> Переведено с разрешения автора.</>
        )}
        {book.copyright && (
          <> <span lang={book.originalLang}>{book.copyright}</span></>
        )}
      </p>

      <nav class="chapter-nav" aria-label="Соседние главы">
        {prev && linkable(prev) ? (
          <a class="chapter-nav__link chapter-nav__prev" href={hrefFor(prev)} rel="prev">
            <span class="chapter-nav__dir" aria-hidden="true">← Назад</span>
            <span class="chapter-nav__title">{prev.title}</span>
            <span class="visually-hidden">Предыдущая глава: {chapterLabel(prev)}</span>
          </a>
        ) : <span></span>}
        {next && linkable(next) ? (
          <a class="chapter-nav__link chapter-nav__next" href={hrefFor(next)} rel="next">
            <span class="chapter-nav__dir" aria-hidden="true">Вперёд →</span>
            <span class="chapter-nav__title">{next.title}</span>
            <span class="visually-hidden">Следующая глава: {chapterLabel(next)}</span>
          </a>
        ) : (
          <span class="chapter-nav__pending">
            {next
              ? `Следующая глава ещё не переведена: «${next.title}».`
              : 'Это последняя глава книги.'}
          </span>
        )}
      </nav>
    </footer>
  </article>
</BaseLayout>

<style>
  :global(main:has(.chapter)) {
    padding-top: 1rem;
  }

  .chapter {
    max-width: 42rem;
  }

  .chapter-book,
  .chapter-original,
  .chapter-source,
  .chapter-nav {
    font-family: var(--sans);
    font-size: 0.85rem;
  }

  .chapter-book {
    margin: 0 0 0.35rem;
    color: var(--text-muted);
  }

  .chapter-book a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 2px;
  }

  .chapter-book a:hover {
    color: var(--link);
  }

  .chapter-head h1 {
    margin-bottom: 0.3rem;
  }

  .chapter-original {
    margin: 0 0 2rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .chapter-tools {
    margin-top: 2.5rem;
  }

  .chapter-foot {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .chapter-source {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .chapter-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .chapter-nav__link {
    display: block;
    text-decoration: none;
    color: var(--fg);
  }

  .chapter-nav__next {
    text-align: right;
  }

  .chapter-nav__dir {
    display: block;
    color: var(--text-muted);
  }

  .chapter-nav__title {
    display: block;
    margin-top: 0.15rem;
  }

  .chapter-nav__link:hover .chapter-nav__title {
    color: var(--link);
  }

  .chapter-nav__link:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .chapter-nav__pending {
    grid-column: 2;
    text-align: right;
    color: var(--text-muted);
  }

  @media (prefers-contrast: more) {
    .chapter-book,
    .chapter-original,
    .chapter-source,
    .chapter-nav__dir,
    .chapter-nav__pending {
      color: var(--fg);
    }
  }

  @media (max-width: 540px) {
    .chapter-nav {
      grid-template-columns: 1fr;
    }

    .chapter-nav__next,
    .chapter-nav__pending {
      grid-column: 1;
      text-align: left;
    }
  }
</style>
