---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import ThemeToggle from './ThemeToggle.svelte';
import LanguageSwitch from './LanguageSwitch.svelte';
import OfflineToggle from './OfflineToggle.svelte';

type Props = { lang: Lang; showTitle?: boolean; minimal?: boolean; backHref?: string };
const { lang, showTitle = true, minimal = false, backHref = `/${lang}/` } = Astro.props;
const t = useTranslations(lang);
const siteName = lang === 'ru' ? 'Евгений Лебедев' : t('site.name');

const offlineLabels = {
  badge: t('offline.badge'),
  badgeTitle: t('offline.badgeTitle'),
  save: t('offline.save'),
  saving: t('offline.saving'),
  saved: t('offline.saved'),
  cancel: t('offline.cancel'),
  remove: t('offline.remove'),
  failed: t('offline.failed'),
  updateAvailable: t('update.available'),
  updateAction: t('update.action'),
  updateDismiss: t('update.dismiss'),
};
---
<header class:list={['site-header', { minimal }]}>
  <div class="header-row">
    {minimal ? (
      <a href={backHref} class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m12 19-7-7 7-7" />
          <path d="M19 12H5" />
        </svg>
        <span>{t('post.back')}</span>
      </a>
    ) : (
      showTitle && (
        <a href={`/${lang}/`} style="text-decoration:none;color:inherit;">
          <h1 class="site-name">{siteName}</h1>
        </a>
      )
    )}
    <div class="actions">
      {!minimal && <LanguageSwitch lang={lang} label={t('lang.switch')} client:load />}
      <OfflineToggle lang={lang} labels={offlineLabels} client:idle />
      <ThemeToggle labelLight={t('theme.light')} labelDark={t('theme.dark')} client:load />
    </div>
  </div>
  {!minimal && <p class="site-tagline">{t('site.tagline')}</p>}
</header>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-muted);
    text-decoration: none;
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--fg);
  }

  .back-link :global(svg) {
    width: 14px;
    height: 14px;
  }
</style>
