# Error reporting. Read at build time and baked into the bundle — see the
# "Error reporting (Sentry)" section of CLAUDE.md. Leave SENTRY_DSN as-is (or
# drop this file) and nothing is sent: no boot scripts, no worker reporter,
# no source maps. `astro dev` never reports either; use `just preview`.
SENTRY_DSN=change-me
SENTRY_ENVIRONMENT=dev
